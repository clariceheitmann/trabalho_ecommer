
@baseUrl = http://localhost:3000


### ==================================================
### 1. CADASTRO DE USUÁRIOS
### ==================================================

### CADASTRAR CLARICE (PÚBLICO)
# @name cadastrarClarice
POST {{baseUrl}}/usuario
Content-Type: application/json

{
    "nome": "Clarice",
    "sobreNome": "Heitmann",
    "idade": 18,
    "email": "clarice@email.com",
    "senha": "123456",
    "telefone": "47999999999",
    "cpf": "529.982.247-25",
    "cep": "01001-000",
    "numero": "100"
}

### CADASTRAR OLIVER (PÚBLICO)
# @name cadastrarOliver
POST {{baseUrl}}/usuario
Content-Type: application/json

{
    "nome": "Oliver",
    "sobreNome": "Santos",
    "idade": 20,
    "email": "oliver@email.com",
    "senha": "123456",
    "telefone": "47999999999",
    "cpf": "086.766.420-79",
    "cep": "01001-000",
    "numero": "100"
}


### ==================================================
### 2. LOGIN
### ==================================================

### LOGIN DE USUÁRIO
# @name loginReq
POST {{baseUrl}}/login
Content-Type: application/json

{
    "email": "oliver@email.com",
    "senha": "123456"
}

### LOGIN DE ADMINISTRADOR
# @name loginAdmin
POST {{baseUrl}}/login/admin
Content-Type: application/json

{
    "email": "clarice@gmail.com",
    "senha": "123"
}


### ==================================================
### 3. USUÁRIOS
### ==================================================

### ------------------------------
### TESTES DE USUÁRIO
### ------------------------------

### CONSULTAR PRÓPRIO USUÁRIO POR ID
GET {{baseUrl}}/usuario/5
Authorization: Bearer {{loginReq.response.body.token}}

### ATUALIZAR PRÓPRIO CADASTRO
PUT {{baseUrl}}/usuario/5
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "nome": "Oliver",
    "sobreNome": "Santos",
    "idade": 18,
    "telefone": "47988888888"
}

### ATUALIZAR PARCIALMENTE PRÓPRIO CADASTRO
PATCH {{baseUrl}}/usuario/5
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "telefone": "47977777777"
}

### TENTAR CONSULTAR OUTRO USUÁRIO POR ID
GET {{baseUrl}}/usuario/1
Authorization: Bearer {{loginReq.response.body.token}}

### TENTAR EXCLUIR OUTRO USUÁRIO
DELETE {{baseUrl}}/usuario/3
Authorization: Bearer {{loginReq.response.body.token}}


### ------------------------------
### TESTES DE ADMINISTRADOR
### ------------------------------

### LISTAR TODOS OS USUÁRIOS
GET {{baseUrl}}/usuarios
Authorization: Bearer {{loginAdmin.response.body.token}}

### CONSULTAR USUÁRIO POR ID
GET {{baseUrl}}/usuario/5
Authorization: Bearer {{loginAdmin.response.body.token}}

### CONSULTAR USUÁRIO POR NOME
GET {{baseUrl}}/usuario/buscar/Oliver
Authorization: Bearer {{loginAdmin.response.body.token}}

### ATUALIZAR USUÁRIO
PUT {{baseUrl}}/usuario/5
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "nome": "Oliver",
    "sobreNome": "Santos",
    "idade": 20,
    "telefone": "47988888888"
}

### ATUALIZAR PARCIALMENTE USUÁRIO
PATCH {{baseUrl}}/usuario/5
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "telefone": "47977777777"
}

### EXCLUIR USUÁRIO
DELETE {{baseUrl}}/usuario/3
Authorization: Bearer {{loginAdmin.response.body.token}}


### ==================================================
### 4. CATEGORIAS
### ==================================================

### ------------------------------
### ROTAS PÚBLICAS
### ------------------------------

### LISTAR CATEGORIAS
GET {{baseUrl}}/categorias

### CONSULTAR CATEGORIA POR ID
GET {{baseUrl}}/categoria/1

### CONSULTAR CATEGORIA POR NOME
GET {{baseUrl}}/categoria/buscar/Rock


### ------------------------------
### TESTES DE ADMINISTRADOR
### ------------------------------

### CADASTRAR CATEGORIA
# @name cadastrarCategoria
POST {{baseUrl}}/categoria
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "nome": "Rock",
    "descricao": "Músicas do gênero rock"
}

### ATUALIZAR CATEGORIA
PUT {{baseUrl}}/categoria/8
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "nome": "Rock Clássico",
    "descricao": "Álbuns de rock clássico"
}

### ATUALIZAR PARCIALMENTE CATEGORIA
PATCH {{baseUrl}}/categoria/8
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "descricao": "Categoria de rock e suas vertentes"
}

### EXCLUIR CATEGORIA
DELETE {{baseUrl}}/categoria/7
Authorization: Bearer {{loginAdmin.response.body.token}}


### ==================================================
### 5. PRODUTOS
### ==================================================

### ------------------------------
### ROTAS PÚBLICAS
### ------------------------------

### LISTAR PRODUTOS
GET {{baseUrl}}/produtos

### CONSULTAR PRODUTO POR ID
GET {{baseUrl}}/produto/2

### CONSULTAR PRODUTO POR NOME
GET {{baseUrl}}/produto/buscar/Abbey%20Road


### ------------------------------
### TESTES DE ADMINISTRADOR
### ------------------------------

### CADASTRAR PRODUTO
# @name cadastrarProduto
POST {{baseUrl}}/produto
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "nome": "Abbey Road",
    "artista": "The Beatles",
    "album": "Abbey Road",
    "formato": "VINIL",
    "ano": 1969,
    "preco": 150.00,
    "imagem": "/imagens/abbey-road.jpg",
    "descricao": "Álbum clássico dos Beatles.",
    "categoria_id": 2
}

### ATUALIZAR PRODUTO
PUT {{baseUrl}}/produto/2
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "nome": "Abbey Road Remasterizado",
    "artista": "The Beatles",
    "album": "Abbey Road",
    "formato": "VINIL",
    "ano": 1969,
    "preco": 180.00,
    "imagem": "/imagens/abbey-road.jpg",
    "descricao": "Edição remasterizada.",
    "categoria_id": 2
}

### ATUALIZAR PARCIALMENTE PRODUTO
PATCH {{baseUrl}}/produto/2
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "preco": 160.00
}

### EXCLUIR PRODUTO
DELETE {{baseUrl}}/produto/2
Authorization: Bearer {{loginAdmin.response.body.token}}


### ==================================================
### 6. ESTOQUE
### ==================================================

### CADASTRAR ESTOQUE
# @name cadastrarEstoque
POST {{baseUrl}}/estoque
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "produto_id": 3,
    "quantidade": 50
}

### LISTAR ESTOQUES
GET {{baseUrl}}/estoques
Authorization: Bearer {{loginAdmin.response.body.token}}

### CONSULTAR ESTOQUE POR ID
GET {{baseUrl}}/estoque/3
Authorization: Bearer {{loginAdmin.response.body.token}}

### ATUALIZAR ESTOQUE
PUT {{baseUrl}}/estoque/3
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "quantidade": 30
}

### EXCLUIR ESTOQUE
DELETE {{baseUrl}}/estoque/3
Authorization: Bearer {{loginAdmin.response.body.token}}


### ==================================================
### 7. PEDIDOS
### ==================================================

### ------------------------------
### TESTES DE USUÁRIO
### ------------------------------


### CADASTRAR PEDIDO
# @name cadastrarPedido
POST {{baseUrl}}/pedido
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "itens": [
        {
            "produto_id": 6,
            "quantidade": 2
        }
    ]
}


### LISTAR PEDIDOS DO PRÓPRIO USUÁRIO
GET {{baseUrl}}/pedidos
Authorization: Bearer {{loginReq.response.body.token}}

### CONSULTAR PRÓPRIO PEDIDO POR ID
GET {{baseUrl}}/pedido/5
Authorization: Bearer {{loginReq.response.body.token}}

### CANCELAR PRÓPRIO PEDIDO
PATCH {{baseUrl}}/pedido/5
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "status": "CANCELADO"
}

### FINALIZAR PRÓPRIO PEDIDO
POST {{baseUrl}}/pedido/7/finalizar
Authorization: Bearer {{loginReq.response.body.token}}

### EXCLUIR PRÓPRIO PEDIDO
DELETE {{baseUrl}}/pedido/6
Authorization: Bearer {{loginReq.response.body.token}}


### ------------------------------
### TESTES DE ADMINISTRADOR
### ------------------------------

### LISTAR TODOS OS PEDIDOS
GET {{baseUrl}}/pedidos
Authorization: Bearer {{loginAdmin.response.body.token}}

### CONSULTAR PEDIDO POR ID
GET {{baseUrl}}/pedido/1
Authorization: Bearer {{loginAdmin.response.body.token}}

### ATUALIZAR PEDIDO
PUT {{baseUrl}}/pedido/1
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "status": "EM_PREPARACAO"
}

### ATUALIZAR PARCIALMENTE PEDIDO
PATCH {{baseUrl}}/pedido/1
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "status": "ENVIADO"
}

### EXCLUIR PEDIDO
DELETE {{baseUrl}}/pedido/5
Authorization: Bearer {{loginAdmin.response.body.token}}


### ==================================================
### 8. ITENS DO PEDIDO
### ==================================================

### ------------------------------
### TESTES DE USUÁRIO
### ------------------------------

### CADASTRAR ITEM NO PRÓPRIO PEDIDO
# @name cadastrarItemPedido
POST {{baseUrl}}/itemPedido
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "pedido_id": 7,
    "produto_id": 4,
    "quantidade": 2
}

### LISTAR ITENS DOS PRÓPRIOS PEDIDOS
GET {{baseUrl}}/itemPedidos
Authorization: Bearer {{loginReq.response.body.token}}

### CONSULTAR ITEM POR ID
GET {{baseUrl}}/itemPedido/7
Authorization: Bearer {{loginReq.response.body.token}}

### ATUALIZAR ITEM DO PRÓPRIO PEDIDO
PUT {{baseUrl}}/itemPedido/4
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "quantidade": 3
}

### EXCLUIR ITEM DO PRÓPRIO PEDIDO
DELETE {{baseUrl}}/itemPedido/4
Authorization: Bearer {{loginReq.response.body.token}}


### ------------------------------
### TESTES DE ADMINISTRADOR
### ------------------------------

### CADASTRAR ITEM EM UM PEDIDO
POST {{baseUrl}}/itemPedido
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "pedido_id": 1,
    "produto_id": 3,
    "quantidade": 1
}

### LISTAR TODOS OS ITENS DOS PEDIDOS
GET {{baseUrl}}/itemPedidos
Authorization: Bearer {{loginAdmin.response.body.token}}

### CONSULTAR ITEM POR ID
GET {{baseUrl}}/itemPedido/7
Authorization: Bearer {{loginAdmin.response.body.token}}

### ATUALIZAR ITEM DE UM PEDIDO
PUT {{baseUrl}}/itemPedido/7
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "quantidade": 4
}

### EXCLUIR ITEM DE UM PEDIDO
DELETE {{baseUrl}}/itemPedido/7
Authorization: Bearer {{loginAdmin.response.body.token}}


### ==================================================
### 9. ENTREGAS
### ==================================================

### CADASTRAR ENTREGA
# @name cadastrarEntrega
POST {{baseUrl}}/entrega
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "pedido_id": 3,
    "endereco": "Rua das Flores, 100, Itapema - SC",
    "codigo_rastreio": "BR123456789",
    "status": "AGUARDANDO_ENVIO"
}

### LISTAR ENTREGAS
GET {{baseUrl}}/entregas
Authorization: Bearer {{loginAdmin.response.body.token}}

### CONSULTAR ENTREGA POR ID
GET {{baseUrl}}/entrega/1
Authorization: Bearer {{loginAdmin.response.body.token}}

### ATUALIZAR ENTREGA
PUT {{baseUrl}}/entrega/1
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "status": "ENVIADO",
    "codigo_rastreio": "BR987654321"
}

### ATUALIZAR PARCIALMENTE ENTREGA
PATCH {{baseUrl}}/entrega/1
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
    "status": "ENTREGUE"
}

### EXCLUIR ENTREGA
DELETE {{baseUrl}}/entrega/1
Authorization: Bearer {{loginAdmin.response.body.token}}
