
@baseUrl = http://localhost:3000

### ==========================================
### USUÁRIOS
### ==========================================

### 1. CADASTRAR USUÁRIO (PÚBLICO)
# @name cadastrarUsuario
POST {{baseUrl}}/usuario
Content-Type: application/json

{
    "nome": "Clarice",
    "sobreNome": "Heitmann",
    "idade": 18,
    "email": "clarice@email.com",
    "senha": "123456",
    "telefone": "47999999999",
    "cpf": "529.982.247-25",
    "cep": "01001-000",
    "numero": "100"
}

### 2. LISTAR USUÁRIOS (PRIVADO)
GET {{baseUrl}}/usuarios
Authorization: Bearer {{loginReq.response.body.token}}

### 3. CONSULTAR USUÁRIO POR ID (PRIVADO)
GET {{baseUrl}}/usuario/1
Authorization: Bearer {{loginReq.response.body.token}}

### 4. CONSULTAR USUÁRIO POR NOME (PRIVADO)
GET {{baseUrl}}/usuario/buscar/Clarice Atualizada
Authorization: Bearer {{loginReq.response.body.token}}

### 5. ATUALIZAR USUÁRIO (PRIVADO)
PUT {{baseUrl}}/usuario/1
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "nome": "Clarice Atualizada",
    "sobreNome": "Heitmann",
    "idade": 19,
    "telefone": "47988888888"
}

### 6. ATUALIZAR PARCIALMENTE USUÁRIO (PRIVADO)
PATCH {{baseUrl}}/usuario/1
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "telefone": "47977777777"
}

### 7. EXCLUIR USUÁRIO (PRIVADO)
DELETE {{baseUrl}}/usuario/3
Authorization: Bearer {{loginReq.response.body.token}}




### ==========================================
### login
### ==========================================

# @name loginReq
POST {{baseUrl}}/login
Content-Type: application/json

{
    "email": "clarice@email.com",
    "senha": "123456"
}




### ==========================================
### CATEGORIAS
### ==========================================

### 1. CADASTRAR CATEGORIA (PRIVADO)
# @name cadastrarCategoria
POST {{baseUrl}}/categoria
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "nome": "Rockaaa",
    "descricao": "Músicas do gênero rock"
}

### 2. LISTAR CATEGORIAS (PÚBLICO)
GET {{baseUrl}}/categorias

### 3. CONSULTAR CATEGORIA POR ID (PÚBLICO)
GET {{baseUrl}}/categoria/1

### 4. CONSULTAR CATEGORIA POR NOME (PÚBLICO)
GET {{baseUrl}}/categoria/buscar/Rock

### 5. ATUALIZAR CATEGORIA (PRIVADO)
PUT {{baseUrl}}/categoria/1
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "nome": "Rock Clássico",
    "descricao": "Álbuns de rock clássico"
}

### 6. ATUALIZAR PARCIALMENTE CATEGORIA (PRIVADO)
PATCH {{baseUrl}}/categoria/1
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "descricao": "Categoria de rock e suas vertentes"
}

### 7. EXCLUIR CATEGORIA (PRIVADO)
DELETE {{baseUrl}}/categoria/7
Authorization: Bearer {{loginReq.response.body.token}}




### ==========================================
### PRODUTOS
### ==========================================

### 1. CADASTRAR PRODUTO (PRIVADO)
# @name cadastrarProduto
POST {{baseUrl}}/produto
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "nome": "Abbey Road",
    "artista": "The Beatles",
    "album": "Abbey Road",
    "formato": "VINIL",
    "ano": 1969,
    "preco": 150.00,
    "imagem": "/imagens/abbey-road.jpg",
    "descricao": "Álbum clássico dos Beatles.",
    "categoria_id": 2
}

### 2. LISTAR PRODUTOS (PÚBLICO)
GET {{baseUrl}}/produtos

### 3. CONSULTAR PRODUTO POR ID (PÚBLICO)
GET {{baseUrl}}/produto/1

### 4. CONSULTAR PRODUTO POR NOME (PÚBLICO)
GET {{baseUrl}}/produto/buscar/Abbey%20Road

### 5. ATUALIZAR PRODUTO (PRIVADO)
PUT {{baseUrl}}/produto/1
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "nome": "Abbey Road Remasterizado",
    "artista": "The Beatles",
    "album": "Abbey Road",
    "formato": "VINIL",
    "ano": 1969,
    "preco": 180.00,
    "imagem": "/imagens/abbey-road.jpg",
    "descricao": "Edição remasterizada.",
    "categoria_id": 2
}

### 6. ATUALIZAR PARCIALMENTE PRODUTO (PRIVADO)
PATCH {{baseUrl}}/produto/1
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "preco": 160.00
}

### 7. EXCLUIR PRODUTO (PRIVADO)
DELETE {{baseUrl}}/produto/1
Authorization: Bearer {{loginReq.response.body.token}}




### ==========================================
### ESTOQUE
### ==========================================

### 1. CADASTRAR ESTOQUE (PRIVADO)
# @name cadastrarEstoque
POST {{baseUrl}}/estoque
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "produto_id": 2,
    "quantidade": 50
}

### 2. LISTAR ESTOQUES (PRIVADO)
GET {{baseUrl}}/estoques
Authorization: Bearer {{loginReq.response.body.token}}

### 3. CONSULTAR ESTOQUE POR ID (PRIVADO)
GET {{baseUrl}}/estoque/2
Authorization: Bearer {{loginReq.response.body.token}}

### 4. ATUALIZAR ESTOQUE (PRIVADO)
PUT {{baseUrl}}/estoque/2
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "quantidade": 30
}

### 5. EXCLUIR ESTOQUE (PRIVADO)
DELETE {{baseUrl}}/estoque/2
Authorization: Bearer {{loginReq.response.body.token}}




### ==========================================
### PEDIDOS
### ==========================================

### 1. CADASTRAR PEDIDO (PRIVADO)
# @name cadastrarPedido
POST {{baseUrl}}/pedido
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "valor_total": 1500.00
}

### 2. LISTAR PEDIDOS DO USUÁRIO (PRIVADO)
GET {{baseUrl}}/pedidos
Authorization: Bearer {{loginReq.response.body.token}}

### 3. CONSULTAR PEDIDO POR ID (PRIVADO)
GET {{baseUrl}}/pedido/1
Authorization: Bearer {{loginReq.response.body.token}}

### 4. ATUALIZAR PEDIDO (PRIVADO)
PUT {{baseUrl}}/pedido/1
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "status": "EM_PREPARACAO"
}

### 5. ATUALIZAR PARCIALMENTE PEDIDO (PRIVADO)
PATCH {{baseUrl}}/pedido/1
Authorization: Bearer {{loginReq.response.body.token}}
Content-Type: application/json

{
    "status": "CANCELADO"
}

### 6. FINALIZAR PEDIDO (PRIVADO)
POST {{baseUrl}}/pedido/1/finalizar
Authorization: Bearer {{loginReq.response.body.token}}

### 7. EXCLUIR PEDIDO (PRIVADO)
DELETE {{baseUrl}}/pedido/2
Authorization: Bearer {{loginReq.response.body.token}}




### ==========================================
### ITENS DO PEDIDO
### ==========================================

### 1. CADASTRAR ITEM DO PEDIDO (PRIVADO)
